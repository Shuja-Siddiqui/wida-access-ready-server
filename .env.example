# Copy this file to .env and fill in the values.
# Never commit .env — it contains real secrets.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ── App ────────────────────────────────────────────────────────────────────
# Local:
APP_URL=http://localhost:3000
# EC2 student app (goelprep.com):
# APP_URL=https://goelprep.com

# ── Database ───────────────────────────────────────────────────────────────
# Local Postgres (npm run dev against localhost):
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accessready
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accessready
# AWS RDS (db:push:aws, npm run db:migrate:live|all — same POSTGRES_* as production API on EC2):
# POSTGRES_HOST=your-instance.region.rds.amazonaws.com
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DATABASE=postgres
# POSTGRES_PORT=5432

# ── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-64-chars-of-random

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Anthropic / AI ─────────────────────────────────────────────────────────
# Local: use a real Anthropic key. Leave the AI_INTEGRATIONS_* vars empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Cap concurrent Anthropic calls (rest wait in FIFO). Stay under nginx 180s timeout.
# CLAUDE_MAX_CONCURRENT=24
# CLAUDE_MAX_QUEUED=512
# CLAUDE_QUEUE_WAIT_MS=150000
# CLAUDE_RETRY_MAX=3
# CLAUDE_RETRY_BASE_MS=400
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# ── Stripe (required for billing locally) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AWS S3 (file / avatar storage) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Pixabay (listening image search) ───────────────────────────────────────
PIXABAY_API_KEY=

# ── Azure Speech (STT/TTS) ─────────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=

# ── Email / SMTP ───────────────────────────────────────────────────────────
EMAIL_FROM=AccessReady <noreply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password  (optional — omit for unauthenticated relay)

# ── Per-student AI rate limit ──────────────────────────────────────────────
# Caps session generate / scoring / TTS / STT per student. Shared via Postgres
# so multiple API boxes stay in sync. To move to Redis later:
#   RATE_LIMIT_STORE=redis
#   REDIS_URL=redis://...
#   npm install redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_STORE=postgres
# REDIS_URL=
# Practice AI calls are also counted in ai_usage_daily (one row per student per UTC day)
# for parent/teacher graphs. Table is created automatically.

# ── Grounding DINO sidecar ─────────────────────────────────────────────────
# Local: http://localhost:8000
# Hosted: https://your-dino-service.fly.dev  (must stay running; not Vercel)
DINO_SIDECAR_URL=http://localhost:8000
# Same value as DINO_API_KEY on the sidecar. Leave empty for local with no auth.
DINO_SIDECAR_TOKEN=
