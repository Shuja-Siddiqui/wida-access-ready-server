# Copy this file to .env and fill in the values.
# Never commit .env — it contains real secrets.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ── App ────────────────────────────────────────────────────────────────────
# Local:
APP_URL=http://localhost:3000
# EC2 student app (goelprep.com):
# APP_URL=https://goelprep.com

# ── Database ───────────────────────────────────────────────────────────────
# Dev — local Postgres or Supabase (db:push / db:migrate:dev uses DATABASE_URL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Optional explicit local override (same as DATABASE_URL when both set):
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Live — AWS RDS (db:push:aws / db:migrate:live — POSTGRES_* on EC2):
# npm run db:migrate:all applies schema to both, then copies library catalog RDS → dev
# (S3 image files are shared; library / topics / content_categories rows stay in sync).
# POSTGRES_HOST=your-instance.region.rds.amazonaws.com
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# POSTGRES_DATABASE=postgres
# POSTGRES_PORT=5432

# ── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-64-chars-of-random

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Anthropic / AI ─────────────────────────────────────────────────────────
# Local: use a real Anthropic key. Leave the AI_INTEGRATIONS_* vars empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Cap concurrent Anthropic calls (rest wait in FIFO). Stay under nginx 180s timeout.
# CLAUDE_MAX_CONCURRENT=24
# CLAUDE_MAX_QUEUED=512
# CLAUDE_QUEUE_WAIT_MS=150000
# CLAUDE_RETRY_MAX=3
# CLAUDE_RETRY_BASE_MS=400
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# ── Stripe (required for billing locally) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AWS S3 (file / avatar storage) ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Pixabay (listening image search) ───────────────────────────────────────
PIXABAY_API_KEY=

# ── Azure Speech (STT/TTS) ─────────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=

# ── Email / SMTP ───────────────────────────────────────────────────────────
EMAIL_FROM=AccessReady <noreply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=false
SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password  (optional — omit for unauthenticated relay)

# ── Internal cron / background jobs (image factory + DINO) ─────────────────
# Generate a long random string (PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})))
# INTERNAL_JOB_API_KEY=
# Uploader for cron = last super_admin who logged in and opened Image Factory (no env var needed).

# ── Image Factory cron (in-process; starts when API server boots) ───────────
# Set to true to continuously fill library pools (prompt → HF → DINO → ingest):
IMAGE_FACTORY_CRON_ENABLED=false
# Cron schedule (default: every 30 minutes). Examples: "0 */2 * * *" = every 2 hours
# IMAGE_FACTORY_CRON_SCHEDULE=*/30 * * * *
# Images per tick (default 4 = one general image per SF: ela, math, science, social_studies):
# IMAGE_FACTORY_CRON_BATCH_SIZE=4
# Pause between batch items (ms):
# IMAGE_FACTORY_CRON_DELAY_MS=10000
# Optional pin (omit to rotate all SF automatically; no per-KLU images):
# IMAGE_FACTORY_CRON_SUBJECT=science
# IMAGE_FACTORY_CRON_LEVEL=3
# Run one batch immediately on server start (default true):
# IMAGE_FACTORY_CRON_RUN_ON_STARTUP=true
# For scripts/image-factory-once.mjs when API is on another host:
# IMAGE_FACTORY_CRON_API_URL=http://localhost:8080

# ── HTTP security ──────────────────────────────────────────────────────────
# Comma-separated allowed browser origins (production). Dev allows any origin.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Per-student AI rate limit ──────────────────────────────────────────────
# Caps session generate / scoring / TTS / STT per student. Shared via Postgres
# so multiple API boxes stay in sync. To move to Redis later:
#   RATE_LIMIT_STORE=redis
#   REDIS_URL=redis://...
#   npm install redis
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30
RATE_LIMIT_STORE=postgres
# Reject requests when rate-limit store is down (default true in production):
# RATE_LIMIT_FAIL_CLOSED=true
# Auth / contact / image-op limits (per IP):
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_CONTACT_MAX=5
# RATE_LIMIT_CONTACT_WINDOW_MS=3600000
# RATE_LIMIT_IMAGE_OPS_MAX=30
# RATE_LIMIT_IMAGE_OPS_WINDOW_MS=60000
# REDIS_URL=
# Practice AI calls are also counted in ai_usage_daily (one row per student per UTC day)
# for parent/teacher graphs. Table is created automatically.

# ── Grounding DINO sidecar ─────────────────────────────────────────────────
# Local: http://localhost:8000
# Hosted: https://your-dino-service.fly.dev  (must stay running; not Vercel)
DINO_SIDECAR_URL=http://localhost:8000
# Same value as DINO_API_KEY on the sidecar. Leave empty for local with no auth.
DINO_SIDECAR_TOKEN=

# ── Hugging Face Inference (cloud image generation — recommended) ───────────
# Create token: https://huggingface.co/settings/tokens
# Enable "Inference Providers" permission. Accept FLUX license on the model page.
HF_TOKEN=
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# HF_IMAGE_PROVIDER=auto   # auto → fal-ai for FLUX.1-schnell
# HF_IMAGE_WIDTH=768
# HF_IMAGE_HEIGHT=512
# HF_IMAGE_STEPS=4
# HF_IMAGE_GUIDANCE_SCALE=0

# ── FLUX.1 Schnell sidecar (local fallback if HF_TOKEN is unset) ────────────
# Local: http://localhost:8001  (see flux-schnell-svc/)
FLUX_SIDECAR_URL=http://localhost:8001
FLUX_SIDECAR_TOKEN=
